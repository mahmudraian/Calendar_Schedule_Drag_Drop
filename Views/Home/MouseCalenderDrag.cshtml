            updatedTask.start_date,
            updatedTask.start_hour
        );

        console.log("total chain Tasks: ", lineTasks);
        console.log("🟢 Chain start:", chainEndDate, chainEndHour);

        for (const task of lineTasks) {
            const taskStartTimeline = toTimelineValue(task.start_date, task.start_hour);
            const taskEndTimeline = toTimelineValue(task.end_date, task.end_hour);

            console.log(`🔍 Checking task ${task.plan_id} | Start: ${taskStartTimeline} | End: ${taskEndTimeline} | ChainEnd: ${chainEndTimeline}`);

            // Task is fully before the chain → ignore
            //if (taskEndTimeline <= chainEndTimeline) continue;

            //// Task starts after chain → safe, chain remains
            //if (taskStartTimeline >= ChainStartTime) continue;

            const noOverlap =
                taskStartTimeline >= chainEndTimeline ||
                taskEndTimeline <= chainStartTimeline;

            console.log("no Over lap", noOverlap);
            console.log(" taskEndTimeline <= chainStartTimeline", taskEndTimeline <= chainStartTimeline);
            console.log(" taskStartTimeline >= chainEndTimeline",  taskStartTimeline >= chainEndTimeline);
            if (noOverlap) continue;

            // REAL overlap → push task
            console.log("❌ CONFLICT → pushing", task.plan_id);
            hasConflict = true;
            // ✅ UPDATED task placed AFTER current chain → STOP
            if (taskStartTimeline <= chainStartTimeline) {
                console.log("================================================================================");
                console.log("✅ Updated task overlaps chain start");
                IsUpdateMain = true;
                chainEndDate = task.end_date;
                chainEndHour = task.end_hour;


