    function getWorkingHour(workingDate) {

        return 12;
        if (!workingDate) return 0;

        const dateObj = new Date(workingDate);

        if (isNaN(dateObj)) return 0; // prevent invalid date crash

        const year = dateObj.getFullYear();
        const month = String(dateObj.getMonth() + 1).padStart(2, "0");

        const key = `${year}-${month}`;

        return workingHourMap[key] ?? 0;
    }

   
    function calculateDuration({
        startDate,
        startHour = 0,
        row,
        totalQuantity,
        learningCurve = [],
        isIncludedHoliday = 0
    }) {
      
        if (!startDate || totalQuantity <= 0) return null;
      
        //alert("startDate :", startDate);

        let qtyToSchedule = totalQuantity;
        let dayIterator = new Date(startDate);
      
        dayIterator.setHours(0, 0, 0, 0);

        const startDateOnly = new Date(startDate);
        startDateOnly.setHours(0, 0, 0, 0);
        
        const manpower = Number(row?.dataset.manpower) || 50;
        const smv = Number(row?.dataset.manpowercapacity) || 30;

        let days = 0;
        let iterator = 0;
        let remainingWorkHour = 0;
        let lastMonthKey = null;
        let workingHours = 0;

        while (qtyToSchedule > 0) {

            const monthKey = `${dayIterator.getFullYear()}-${dayIterator.getMonth()}`;


            // ---- Skip Holiday ----
            if (isIncludedHoliday !== 1) {
                while (isDisabledDay(dayIterator)) {
                    dayIterator.setDate(dayIterator.getDate() + 1);
                    days++;
                }
            }

            const monthNumber = dayIterator.getMonth() + 1; // 1-12
            const year = dayIterator.getFullYear();

            //if (monthKey !== lastMonthKey) {
            //    workingHours = workingHourMap[monthKey] ?? 0;

            //    lastMonthKey = monthKey;
            //}

            if (monthKey !== lastMonthKey) {

                if (!(monthKey in workingHourMap)) {
                    //alert(`Working hour not found for month: ${monthKey}`);
                    workingHours = 12; // or return / throw error based on your logic
                    //return;
                } else {
                    workingHours = workingHourMap[monthKey];
                }

                lastMonthKey = monthKey;
            }


            // ---- Get Working Hours ----
           
            let workhour = workingHours;

            //console.clear();
            console.log("workingHours :", workingHours);

            console.log("~~~~~~~~~~~~~~~~~~~~~~~~~~workhour~~~~~~~~~~~~~~~~~~~~~~~`");
            console.log("workhour  :", workhour);
            console.log("~~~~~~~~~~~~~~~~~~~~~~~~~~workhour~~~~~~~~~~~~~~~~~~~~~~~`");
            // ---- First Day Partial Handling ----
            if (dayIterator.getTime() === startDateOnly.getTime()) {
                workhour = Math.max(workingHours - startHour, 0);
            }

            if (workhour <= 0) {
                dayIterator.setDate(dayIterator.getDate() + 1);
                continue;
            }

            // ---- Learning Curve ----
            let efficiency = 1;

            if (learningCurve.length > 0) {
                const index = Math.min(iterator, learningCurve.length - 1);
                console.log("~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~learningCurve[index] :", learningCurve[index]);
                efficiency = parseFloat(learningCurve[index]) / 100;
            }

            console.log("efficiency :", efficiency);
            // ---- Daily Output ----
            const totalDailyMinutes = manpower * workhour * 60;

            let dayOutput = Math.floor(
                efficiency * (totalDailyMinutes / smv)
            );

            if (dayOutput <= 0) return null;

            let usedWorkHour = workhour;

            // ---- Last Day Partial ----
            if (dayOutput >= qtyToSchedule) {

                const ratio = qtyToSchedule / dayOutput;
                usedWorkHour = workhour * ratio;

                remainingWorkHour = workhour - usedWorkHour;
                dayOutput = qtyToSchedule;
            }

            qtyToSchedule -= dayOutput;

            // ---- Add Day Fraction ----
            days += usedWorkHour / workingHours;

            // ---- Move Next Day ----
            dayIterator.setDate(dayIterator.getDate() + 1);
            iterator++;
            startHour = 0;
        }

        // ---- Fix End Date ----
        const endDate = new Date(dayIterator);
        endDate.setDate(endDate.getDate() - 1);

        const endDateWorkingHours = getWorkingHour(endDate);
    //    const endDateWorkingHours = 12;
        const endHour = parseInt(endDateWorkingHours - remainingWorkHour);

        return {
            startDate,
            endDate,
            endHour,
            duration: Number(days.toFixed(3))
        };
    }






