    function normalizeDate(dateVal) {
        if (!dateVal) return null;

        // Already Date
        if (dateVal instanceof Date) {
            return new Date(
                dateVal.getFullYear(),
                dateVal.getMonth(),
                dateVal.getDate()
            );
        }

        // DD-MM-YYYY
        if (typeof dateVal === "string" && dateVal.includes("-")) {
            const parts = dateVal.split("-");
            if (parts[0].length === 2) {
                const [dd, mm, yyyy] = parts.map(Number);
                return new Date(yyyy, mm - 1, dd);
            }
        }

        // ISO fallback
        const d = new Date(dateVal);
        if (!isNaN(d)) {
            return new Date(d.getFullYear(), d.getMonth(), d.getDate());
        }

        return null;
    }


    function toTimelineValue(dateVal, workingHourIndex) {

        const hour = Number(workingHourIndex);
        if (Number.isNaN(hour)) {
            console.error("❌ Invalid hour:", workingHourIndex);
            return NaN;
        }

        const d = normalizeDate(dateVal);
        if (!d) {
            console.error("❌ Invalid date:", dateVal);
            return NaN;
        }

        return d.getTime() + hour * 60 * 60 * 1000;
    }






    function isBefore(d1, h1, d2, h2) {
        return d1 < d2 || (d1 === d2 && h1 < h2);
    }

    function isAfter(d1, h1, d2, h2) {
        return d1 > d2 || (d1 === d2 && h1 > h2);
    }







    function toDateTime(dateStr, hour) {
        const d = new Date(dateStr);
        d.setHours(hour, 0, 0, 0);
        return d;
    }

    function formatDate(date) {
        return date.toISOString().split("T")[0];
    }

   






