    function AllPlansByLineId(lineId, updatedTask, lastHover) {
        // Get all tasks in the line, excluding the updated task
        const lineTasks = tasks
            .filter(t => t.line_id === lineId && t.plan_id !== updatedTask.plan_id)
            .sort((a, b) => toTimelineValue(a.start_date, a.start_hour) - toTimelineValue(b.start_date, b.start_hour));

        let hasConflict = false;

        // Chain starts from the updated task's END
        let chainEndDate = updatedTask.end_date;
        let chainEndHour = updatedTask.end_hour;
        let chainStartDate = updatedTask.start_date;
        let chainStartHour = updatedTask.start_hour;
        let chainEndTimeline = toTimelineValue(chainEndDate, chainEndHour);
        let chainStartTimeline = toTimelineValue(chainStartDate, chainStartHour);

        console.log("🟢 Chain start:", chainEndDate, chainEndHour);

        for (const task of lineTasks) {
            const taskStartTimeline = toTimelineValue(task.start_date, task.start_hour);
            const taskEndTimeline = toTimelineValue(task.end_date, task.end_hour);

            console.log(`🔍 Checking task ${task.plan_id} | Start: ${taskStartTimeline} | End: ${taskEndTimeline} | ChainEnd: ${chainEndTimeline}`);

            // Task is fully before the chain → ignore
            //if (taskEndTimeline <= chainEndTimeline) continue;

            //// Task starts after chain → safe, chain remains
            //if (taskStartTimeline >= ChainStartTime) continue;

            const noOverlap =
                taskStartTimeline >= chainEndTimeline ||
                taskEndTimeline <= chainStartTimeline;
            console.log("no Over lap", noOverlap);
            console.log(" taskEndTimeline <= chainStartTimeline", taskEndTimeline <= chainStartTimeline);
            console.log(" taskStartTimeline >= chainEndTimeline",  taskStartTimeline >= chainEndTimeline);
            if (noOverlap) continue;

            // REAL overlap → push task
            console.log("❌ CONFLICT → pushing", task.plan_id);
            hasConflict = true;

            const pushed = pushTaskAfter(task, chainEndDate, chainEndHour, lastHover);

            // If push fails, skip but continue chain
            if (!pushed) continue;

            // Extend chain to new task end
            chainEndDate = pushed.endDateDMY;
            chainEndHour = pushed.endHour;
            chainEndTimeline = toTimelineValue(chainEndDate, chainEndHour);

            console.log("⏩ Chain extended to:", chainEndDate, chainEndHour);
        }

        // If conflicts occurred, re-render tasks
        if (hasConflict) {
            const fromDate = parseDateSafe($('input[name="FromDate"]').val());
            const toDate = parseDateSafe($('input[name="ToDate"]').val());

            requestAnimationFrame(() => renderTasks(fromDate, toDate));
        } else {
            console.log("✅ No conflicts detected");
        }
    }





    function pushTaskAfter(task, startDate, startHour, hover) {

        const result = getDurationForBalance(
            convertToDMY(startDate),
            parseInt(startHour, 10),
            hover,
            task.plan_qnty
        );
        console.log("=======================================result", result);
        if (!result) return null;

        const endDateDMY = convertToDMY(formatYMD(result.endDate));
        console.log("=======================================endDateDMY", endDateDMY, "================plan", task.plan_id);
        task.start_date = startDate;
        task.start_hour = parseInt(startHour, 10);
        task.end_date = endDateDMY;
        task.end_hour = result.endHour;
        task.duration = result.duration;

        // ✅ return normalized values for chaining
        return {
            endDateDMY,
            endHour: result.endHour,
            duration: result.duration
        };
    }





