    function buildWorkingHourMap(calenderdata) {
        workingHourMap = {};

        calenderdata?.forEach(item => {
            const dateObj = parseCustomDate(item.APPLYING_PERIOD_DATE);
            if (!dateObj) return;

            const key = `${dateObj.getFullYear()}-${dateObj.getMonth()}`;
            // Month stored as 0-11 (JS standard)

            workingHourMap[key] = Number(item.WORKING_HOUR);
        });
    }

    function getWorkingHourByMonth(date) {
        if (!date) return 0;

        const d = new Date(date);
        const key = `${d.getFullYear()}-${d.getMonth()}`;

        return workingHourMap[key] ?? 0;
    }






