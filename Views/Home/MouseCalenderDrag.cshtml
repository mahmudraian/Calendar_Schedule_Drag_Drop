                console.log("lastHover                 :", lastHover);
                console.log("================================================================================");
                const pushed = pushTaskAfter(task, chainEndDate, chainEndHour, lastHover);



                // If push fails, skip but continue chain
                if (!pushed) continue;

                // Extend chain to new task end
                chainEndDate = pushed.endDateDMY;
                chainEndHour = pushed.endHour;
                chainEndTimeline = toTimelineValue(chainEndDate, chainEndHour);

                console.log("⏩ Chain extended to:", chainEndDate, chainEndHour);
            }

        }
