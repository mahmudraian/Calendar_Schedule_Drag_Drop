            console.log("✅ No conflicts detected");
        }
    }





    function pushTaskAfter(task, startDate, startHour, hover) {

        updateForSavePlan(task);
        console.log("=======================================startDate", startDate);
        const result = getDurationForBalance(
            convertToDMY(startDate),
            parseInt(startHour, 10),
            hover,
            task.plan_qnty,
            task.IsIncludedHoliday
        );

        console.log("=======================================result", result);

        if (!result) return null;

        const endDateDMY = convertToDMY(formatYMD(result.endDate));
        console.log("=======================================endDateDMY", endDateDMY, "================plan", task.plan_id);
        task.start_date = startDate;
        task.start_hour = parseInt(startHour, 10);
        task.end_date = endDateDMY;
        task.end_hour = result.endHour;
        task.duration = result.duration;
       updateForSavePlan(task);
        // ✅ return normalized values for chaining
        return {
            endDateDMY,
            endHour: result.endHour,
            duration: result.duration
        };
    }

  

    function updateForSavePlan(task) {

        const index = ForSavePlan.findIndex(
            p => p.plan_id === task.plan_id
        );

        if (index !== -1) {
            // update existing
            ForSavePlan[index] = { ...task };
        } else {
            // insert new
            ForSavePlan.push({ ...task });
        }


        console.log("=======================================updateForSavePlan", ForSavePlan);
    }


    function renderAfterChangeDebounced(delay = 50) {

        if (renderTimeout) clearTimeout(renderTimeout);
        if (rafId) cancelAnimationFrame(rafId);

        console.log("renderAfterChangeDebounced");
        renderTimeout = setTimeout(() => {
            rafId = requestAnimationFrame(() => {


                 const fromDate = new Date(@Html.Raw(Json.Encode(ViewBag.StartDate)));
                 const toDate = new Date(@Html.Raw(Json.Encode(ViewBag.EndDate)));

                renderTasks(allPlan);
                rafId = null;
            });
        }, delay);
    }




