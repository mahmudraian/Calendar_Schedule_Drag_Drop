    const SCROLL_EDGE_SIZE = 50; //40
    const SCROLL_SPEED = 15;

    let scrollRAF = null;
    let scrollX = 0;
    let scrollY = 0;

    function autoScrollCalendar(mouseX, mouseY) {
        const cal = document.getElementById("calendar-wrapper");
        if (!cal) return;

        const rect = cal.getBoundingClientRect();

        scrollX = 0;
        scrollY = 0;

        // Vertical
        if (mouseY < rect.top + SCROLL_EDGE_SIZE) {
            scrollY = -SCROLL_SPEED;
        } else if (mouseY > rect.bottom - SCROLL_EDGE_SIZE) {
            scrollY = SCROLL_SPEED;
        }

        // Horizontal
        if (mouseX < rect.left + SCROLL_EDGE_SIZE) {
            scrollX = -SCROLL_SPEED;
        } else if (mouseX > rect.right - SCROLL_EDGE_SIZE) {
            scrollX = SCROLL_SPEED;
        }

        if (scrollX || scrollY) startScroll(cal);
        else stopScroll();
    }

    function startScroll(cal) {
        if (scrollRAF) return;

        function step() {
            if (!isDragging) {
                stopScroll();
                return;
            }

            cal.scrollTop += scrollY;
            cal.scrollLeft += scrollX;

            scrollRAF = requestAnimationFrame(step);
        }

        scrollRAF = requestAnimationFrame(step);
    }

    function stopScroll() {
        if (scrollRAF) {
            cancelAnimationFrame(scrollRAF);
            scrollRAF = null;
        }
    }




