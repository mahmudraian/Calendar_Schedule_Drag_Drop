    function calculateTotalHours(
        startDate,
        startHour,
        endDate,
        endHour,
        isIncludedHoliday
    ) {

        //const start = new Date(startDate);
        //const end = new Date(endDate);

        if (!startDate || !endDate) {
            console.error("Missing startDate or endDate", { startDate, endDate });
            return 0;
        }

        const start = new Date(startDate);
        const end = new Date(endDate);

        if (isNaN(start) || isNaN(end)) {
            console.error("Invalid date value", { startDate, endDate });
            return 0;
        }

        start.setHours(0, 0, 0, 0);
        end.setHours(0, 0, 0, 0);

        let totalHours = 0;
        let current = new Date(start);

        while (current <= end) {
            const calmonthKey = `${current.getFullYear()}-${current.getMonth()}`;

            let lastMonthKeyForCal = null;
           

            if (calmonthKey !== lastMonthKeyForCal) {
                workingHour = workingHourMap[calmonthKey] ?? 0;
                lastMonthKeyForCal = calmonthKey;
            }

            console.log("workingHour :", workingHour);
            if (!isDisabledDay(current)) {

                if (
                    current.getTime() === start.getTime() &&
                    current.getTime() === end.getTime()
                ) {
                    const workedHours = endHour - startHour;
                    totalHours += workedHours;
                    console.log("same day :", totalHours);
                }

                // First day
                else
                    if (current.getTime() === start.getTime()) {

                    totalHours += WORKING_HOURS - startHour;
                        console.log("first Date : ", totalHours);

                }
                // Last day
                else if (current.getTime() === end.getTime()) {
                    console.log("last Date : ", totalHours);
                    totalHours += endHour;
                    console.log("mid Date : ", totalHours);
                }
                // Middle day
                else {
                    totalHours += WORKING_HOURS;
                    console.log("last Date : ", totalHours);
                }
            }

            current.setDate(current.getDate() + 1);
        }

        return Math.max(0, totalHours);
