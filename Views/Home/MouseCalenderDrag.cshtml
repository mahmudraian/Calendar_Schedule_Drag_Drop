    function calculateDuration({
        startDate,
        startHour,
        row,
        totalQuantity
    }) {
      
        const manpower = Number(row?.dataset.manpower) || 0;
        const hourlyQty = Number(row?.dataset.manpowercapacity) || 0;

        let efficiencyRaw = row?.dataset.efficiency || 0;
        const efficiency = efficiencyRaw.toString().includes("%")
            ? parseFloat(efficiencyRaw) / 100
            : parseFloat(efficiencyRaw);
        console.log("===============  calculateDuration END =============");
        if (totalQuantity <= 0 || efficiency <= 0 || hourlyQty <= 0) {
            return null;
        }
       
        /* ---------- TOTAL HOURS ---------- */
        const effectiveHourlyOutput = hourlyQty * efficiency;

        // KEEP decimal precision
        const totalHours = Number(
            (totalQuantity / effectiveHourlyOutput).toFixed(1)
        );

        /* ---------- DURATION (1.1 format) ---------- */
        const days = Math.floor(totalHours / WORKING_HOURS);
        const hours = Math.round(totalHours % WORKING_HOURS);

        const duration = Number(`${days}.${hours}`);

        /* ---------- END HOUR & DAY OFFSET ---------- */
        let endHour = startHour + hours;
        let endDayOffset = days;

        if (endHour >= WORKING_HOURS) {
            endDayOffset += Math.floor(endHour / WORKING_HOURS);
            endHour = endHour % WORKING_HOURS;
        }

        /* ---------- END DATE ---------- */
        const endDate = new Date(startDate);
        console.log("============================endDate Before Before", endDate);
        if (isNaN(endDate)) return null;
        console.log("============================endDate Before", endDate);
        endDate.setDate(endDate.getDate() + endDayOffset);

            console.log("==================   calculation time  =====================");
            console.log("startDate", startDate);
            console.log("endDate", convertToDMY(formatYMD(endDate)));
            console.log("endHour", endHour);
            console.log("duration", duration);
            console.log("hourlyQty", hourlyQty);
            console.log("Total Quantity", totalQuantity);
            console.log("manpower", manpower);
            console.log("endDayOffset", endDayOffset);
            console.log("========================================================");



        return {
            startDate,
            endDate,
            endHour,
            duration // 👉 1.1 format
        };
    }


    function getDuration(hover, totalQuantity) {

        const { row, cell, hour: startHour } = hover;

        return calculateDuration({
            startDate: cell.dataset.date, // from cell
            startHour,
            row,
            totalQuantity
        });
    }

    function getDurationForBalance(startDate, startHour, hover, totalQuantity) {

        const { row } = hover;
        console.log("================================================================================getDurationForBalance");
        console.log("================================================================================startDate", startDate);
        console.log("================================================================================startDate", startHour);
        return calculateDuration({
            startDate,        
            startHour,
            row,
            totalQuantity
        });
    }

    function getDurationInDaysHours(totalHours) {
        const days = Math.floor(totalHours / WORKING_HOURS);
        const hours = Math.round(totalHours % WORKING_HOURS);

        return Number(`${days}.${hours}`);
    }    

